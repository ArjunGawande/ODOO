# Copy to .env.local and fill in. Never commit real values.

# Postgres connection used by the app, knex CLI and seeds.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE

# Database wiped by the test suite. Its name must contain "test".
TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE_test

# Public base URL, used in password reset and invite links.
APP_URL=http://localhost:3000

# Business timezone used for "today" and plan availability.
APP_TIMEZONE=Asia/Kolkata

# SMTP. Leave SMTP_HOST empty in development to log mail to the server console.
# In production an empty SMTP_HOST is a configuration error and no mail is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Brightloop <no-reply@example.com>

# First admin. Defaults apply in development; both are required in production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
